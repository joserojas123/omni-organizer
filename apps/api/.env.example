# PostgreSQL connection used by Prisma. Matches docker-compose.dev.yml (host port 5434).
DATABASE_URL="postgresql://omniorganizer:omniorganizer@localhost:5434/omniorganizer?schema=public"

# HTTP port the API listens on.
PORT=4000

# Comma-separated list of allowed CORS origins (the web app).
CORS_ORIGIN="http://localhost:3000"
