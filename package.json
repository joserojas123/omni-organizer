{
  "name": "omni-organizer",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@omni-organizer/web --filter=@omni-organizer/api",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,md}\"",
    "postinstall": "pnpm --filter @omni-organizer/shared build",
    "db:up": "docker-compose -f docker-compose.dev.yml up -d",
    "db:down": "docker-compose -f docker-compose.dev.yml down",
    "desktop:dev": "pnpm --filter @omni-organizer/desktop dev",
    "desktop:build": "pnpm --filter @omni-organizer/desktop build"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
